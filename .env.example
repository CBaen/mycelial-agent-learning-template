# ============================================================================
# Mycelial Agent Engine (MAE) - Environment Variables
# ============================================================================
#
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# Environment variables override config.yaml settings
#
# ============================================================================

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================================================
# Vector Database Configuration
# ============================================================================
VECTOR_DB_BACKEND=chromadb
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=8000

# ============================================================================
# Application Configuration
# ============================================================================
MAE_CONFIG_PATH=config/config.yaml
LOG_LEVEL=INFO

# ============================================================================
# External API Keys (Domain-Specific)
# ============================================================================

# Example: Stock Market Data (Finance Domain)
# DATA_SOURCE_API_KEY=your_alphavantage_api_key
# DATA_SOURCE_ENDPOINT=https://www.alphavantage.co/query

# Example: Google Maps (Logistics Domain)
# MAPS_API_KEY=your_google_maps_api_key
# MAPS_API_ENDPOINT=https://maps.googleapis.com/maps/api

# Example: Threat Intelligence (Cybersecurity Domain)
# THREAT_INTEL_API_KEY=your_threat_intel_api_key
# THREAT_INTEL_ENDPOINT=https://api.threatintel.com/v1

# ============================================================================
# Production Settings
# ============================================================================

# Set to 'production' for production deployment
# ENVIRONMENT=development

# Python settings
# PYTHONUNBUFFERED=1
# PYTHONDONTWRITEBYTECODE=1

# ============================================================================
# Docker Settings
# ============================================================================

# Compose project name
# COMPOSE_PROJECT_NAME=mae

# ============================================================================
# Monitoring and Observability (Optional)
# ============================================================================

# Prometheus metrics endpoint
# PROMETHEUS_PORT=9090

# Sentry error tracking
# SENTRY_DSN=your_sentry_dsn

# ============================================================================
# REST API Settings
# ============================================================================

# API server configuration
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=4

# Enable API documentation
API_DOCS_ENABLED=true

# CORS origins (comma-separated)
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================================================
# Security (Production)
# ============================================================================

# JWT secret for authentication (CHANGE THIS IN PRODUCTION!)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-please-use-strong-random-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Encryption key for sensitive data
# ENCRYPTION_KEY=your_encryption_key_here

# ============================================================================
# Monitoring and Metrics
# ============================================================================

# Enable Prometheus metrics
PROMETHEUS_ENABLED=true

# Grafana admin password
GRAFANA_PASSWORD=admin

# Enable distributed tracing
TRACING_ENABLED=false

# ============================================================================
# Kubernetes Settings
# ============================================================================

# Kubernetes namespace
K8S_NAMESPACE=mae

# Service account
K8S_SERVICE_ACCOUNT=mae-service-account

# ============================================================================
# Feature Flags
# ============================================================================

# Enable debug mode
DEBUG_MODE=false

# Enable policy export
ENABLE_POLICY_EXPORT=true

# Enable metrics collection
ENABLE_METRICS=true
