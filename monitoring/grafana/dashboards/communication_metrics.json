{
  "dashboard": {
    "title": "MAE Communication Metrics",
    "tags": ["mae", "communication", "messaging"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "5s",
    "time": {
      "from": "now-15m",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Messages Sent Rate",
        "type": "graph",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "rate(mae_communication_messages_sent_total[1m])",
            "legendFormat": "{{message_type}} from {{agent_id}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "msgs",
            "label": "Messages/sec"
          }
        ]
      },
      {
        "id": 2,
        "title": "Messages Received Rate",
        "type": "graph",
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "rate(mae_communication_messages_received_total[1m])",
            "legendFormat": "{{message_type}} to {{agent_id}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "msgs",
            "label": "Messages/sec"
          }
        ]
      },
      {
        "id": 3,
        "title": "Message Latency by Type (p50, p95, p99)",
        "type": "graph",
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(mae_communication_message_latency_seconds_bucket[5m]))",
            "legendFormat": "p50 - {{message_type}}",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(mae_communication_message_latency_seconds_bucket[5m]))",
            "legendFormat": "p95 - {{message_type}}",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, rate(mae_communication_message_latency_seconds_bucket[5m]))",
            "legendFormat": "p99 - {{message_type}}",
            "refId": "C"
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Latency"
          }
        ],
        "alert": {
          "name": "High Message Latency",
          "conditions": [
            {
              "evaluator": {
                "params": [0.01],
                "type": "gt"
              },
              "query": {
                "params": ["C", "5m", "now"]
              },
              "reducer": {
                "params": [],
                "type": "avg"
              },
              "type": "query"
            }
          ]
        }
      },
      {
        "id": 4,
        "title": "GNN Routing Efficiency",
        "type": "graph",
        "gridPos": {
          "x": 12,
          "y": 8,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "mae_communication_gnn_routing_efficiency",
            "legendFormat": "Routing Efficiency",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "percentunit",
            "label": "Efficiency",
            "min": 0,
            "max": 1
          }
        ],
        "thresholds": [
          {
            "value": 0.7,
            "colorMode": "custom",
            "op": "lt",
            "fill": true,
            "line": true,
            "fillColor": "rgba(255, 0, 0, 0.3)"
          }
        ]
      },
      {
        "id": 5,
        "title": "Message Volume by Type",
        "type": "graph",
        "gridPos": {
          "x": 0,
          "y": 16,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "sum by (message_type) (rate(mae_communication_messages_sent_total[5m]))",
            "legendFormat": "{{message_type}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "msgs",
            "label": "Messages/sec"
          }
        ],
        "seriesOverrides": [
          {
            "alias": "BROADCAST",
            "color": "#1f77b4"
          },
          {
            "alias": "UNICAST",
            "color": "#ff7f0e"
          },
          {
            "alias": "MULTICAST",
            "color": "#2ca02c"
          }
        ]
      },
      {
        "id": 6,
        "title": "Top Communicating Agents",
        "type": "table",
        "gridPos": {
          "x": 12,
          "y": 16,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "topk(10, sum by (agent_id) (rate(mae_communication_messages_sent_total[5m])))",
            "format": "table",
            "instant": true,
            "refId": "A"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true,
                "__name__": true
              },
              "indexByName": {
                "agent_id": 0,
                "Value": 1
              },
              "renameByName": {
                "agent_id": "Agent ID",
                "Value": "Messages/sec"
              }
            }
          }
        ]
      },
      {
        "id": 7,
        "title": "Total Messages Sent",
        "type": "stat",
        "gridPos": {
          "x": 0,
          "y": 24,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "sum(mae_communication_messages_sent_total)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            }
          }
        }
      },
      {
        "id": 8,
        "title": "Total Messages Received",
        "type": "stat",
        "gridPos": {
          "x": 6,
          "y": 24,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "sum(mae_communication_messages_received_total)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            }
          }
        }
      },
      {
        "id": 9,
        "title": "Avg Message Latency",
        "type": "stat",
        "gridPos": {
          "x": 12,
          "y": 24,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(mae_communication_message_latency_seconds_bucket[5m]))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 0.005, "color": "yellow"},
                {"value": 0.01, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 10,
        "title": "Current Routing Efficiency",
        "type": "gauge",
        "gridPos": {
          "x": 18,
          "y": 24,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "mae_communication_gnn_routing_efficiency",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 1,
            "unit": "percentunit",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 0.7, "color": "yellow"},
                {"value": 0.85, "color": "green"}
              ]
            }
          }
        }
      }
    ]
  }
}
