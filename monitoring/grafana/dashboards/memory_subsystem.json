{
  "dashboard": {
    "title": "MAE Memory Subsystem",
    "tags": ["mae", "memory", "episodic"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "5s",
    "time": {
      "from": "now-15m",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Episodic Buffer Utilization",
        "type": "graph",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "mae_memory_episodic_buffer_size / mae_memory_episodic_buffer_capacity",
            "legendFormat": "{{agent_id}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "percentunit",
            "label": "Utilization",
            "min": 0,
            "max": 1
          }
        ],
        "thresholds": [
          {
            "value": 0.9,
            "colorMode": "critical",
            "op": "gt",
            "fill": true,
            "line": true
          }
        ]
      },
      {
        "id": 2,
        "title": "Buffer Size vs Capacity",
        "type": "graph",
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "mae_memory_episodic_buffer_size",
            "legendFormat": "{{agent_id}} (size)",
            "refId": "A"
          },
          {
            "expr": "mae_memory_episodic_buffer_capacity",
            "legendFormat": "{{agent_id}} (capacity)",
            "refId": "B"
          }
        ],
        "yaxes": [
          {
            "format": "short",
            "label": "Experiences"
          }
        ]
      },
      {
        "id": 3,
        "title": "Replay Operations Rate",
        "type": "graph",
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "rate(mae_memory_replay_total[1m])",
            "legendFormat": "{{agent_id}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "ops",
            "label": "Replays/sec"
          }
        ]
      },
      {
        "id": 4,
        "title": "Consolidation Operations Rate",
        "type": "graph",
        "gridPos": {
          "x": 12,
          "y": 8,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "rate(mae_memory_consolidation_total[1m])",
            "legendFormat": "{{agent_id}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "ops",
            "label": "Consolidations/sec"
          }
        ]
      },
      {
        "id": 5,
        "title": "Buffer Utilization Heatmap",
        "type": "heatmap",
        "gridPos": {
          "x": 0,
          "y": 16,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "mae_memory_episodic_buffer_size / mae_memory_episodic_buffer_capacity",
            "format": "time_series",
            "refId": "A"
          }
        ],
        "yAxis": {
          "format": "percentunit"
        },
        "color": {
          "mode": "spectrum",
          "cardColor": "#b4ff00",
          "colorScale": "sqrt",
          "exponent": 0.5,
          "colorScheme": "interpolateRdYlGn"
        }
      },
      {
        "id": 6,
        "title": "Memory Operations by Agent",
        "type": "table",
        "gridPos": {
          "x": 12,
          "y": 16,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "sum by (agent_id) (rate(mae_memory_replay_total[5m]))",
            "format": "table",
            "instant": true,
            "refId": "A"
          },
          {
            "expr": "sum by (agent_id) (rate(mae_memory_consolidation_total[5m]))",
            "format": "table",
            "instant": true,
            "refId": "B"
          }
        ],
        "transformations": [
          {
            "id": "merge",
            "options": {}
          },
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true,
                "__name__": true
              },
              "indexByName": {
                "agent_id": 0,
                "Value #A": 1,
                "Value #B": 2
              },
              "renameByName": {
                "agent_id": "Agent ID",
                "Value #A": "Replays/sec",
                "Value #B": "Consolidations/sec"
              }
            }
          }
        ]
      },
      {
        "id": 7,
        "title": "Total Replay Operations",
        "type": "stat",
        "gridPos": {
          "x": 0,
          "y": 24,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "sum(mae_memory_replay_total)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            }
          }
        }
      },
      {
        "id": 8,
        "title": "Total Consolidations",
        "type": "stat",
        "gridPos": {
          "x": 6,
          "y": 24,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "sum(mae_memory_consolidation_total)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            }
          }
        }
      },
      {
        "id": 9,
        "title": "Avg Buffer Utilization",
        "type": "gauge",
        "gridPos": {
          "x": 12,
          "y": 24,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "avg(mae_memory_episodic_buffer_size / mae_memory_episodic_buffer_capacity)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 1,
            "unit": "percentunit",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 0.7, "color": "yellow"},
                {"value": 0.9, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 10,
        "title": "Agents with Full Buffers",
        "type": "stat",
        "gridPos": {
          "x": 18,
          "y": 24,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "count(mae_memory_episodic_buffer_size == mae_memory_episodic_buffer_capacity)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 1, "color": "yellow"},
                {"value": 5, "color": "red"}
              ]
            }
          }
        }
      }
    ]
  }
}
